---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title?: string;
  description?: string;
  activeComponent?: string;
}

const { title, description, activeComponent } = Astro.props;

const components = [
  'Accordion', 'Alert', 'Avatar', 'Badge', 'Breadcrumb',
  'Button', 'Card', 'Checkbox', 'Dialog', 'Input',
  'Select', 'Slider', 'Switch', 'Tabs', 'Toast', 'Tooltip',
];

const overview = ['Introduction', 'Get started', 'Styling', 'Changelog'];

const isComponent = components.map(c => c.toLowerCase()).includes(activeComponent || '');
---

<BaseLayout title={title ? `${title} - Mono DS` : 'Mono DS'} description={description}>

  <header class="fixed top-0 left-0 right-0 z-50 h-12 border-b border-border bg-neutral/90 backdrop-blur-sm flex items-center px-4 md:px-6 gap-4">
    <a href="/" class="flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 32 32" fill="none"><path d="M16 2L30 16L16 30L2 16L16 2Z" fill="white"/></svg>
    </a>
    <nav class="flex items-center gap-1">
      <a href="/docs/introduction" class="px-3 py-1.5 text-sm font-mono text-muted hover:text-white transition-colors duration-150">Docs</a>
      <a href="/components" class="px-3 py-1.5 text-sm font-mono text-muted hover:text-white transition-colors duration-150">Components</a>
    </nav>
    <div class="ml-auto flex items-center gap-3">
      <a href="https://github.com/Manekenthe/mono-ds" target="_blank" class="text-muted hover:text-white transition-colors duration-150">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
      </a>
      <a href="https://x.com/builtwithmono" target="_blank" class="text-muted hover:text-white transition-colors duration-150">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.736l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
    </div>
  </header>

  <div class="flex pt-12 min-h-screen">
    <aside class="hidden md:block fixed left-0 top-12 bottom-0 w-[220px] border-r border-border overflow-y-auto py-6 px-4 shrink-0">
      <div class="mb-6">
        <p class="text-[11px] font-mono font-medium text-muted uppercase tracking-wider mb-2 px-2">Overview</p>
        <ul class="space-y-0.5">
          {overview.map((item) => (
            <li>
              <a
                href={`/docs/${item.toLowerCase().replace(' ', '-')}`}
                class="block px-2 py-1.5 text-sm font-mono text-muted hover:text-white rounded-sm transition-colors duration-150"
              >
                {item}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-[11px] font-mono font-medium text-muted uppercase tracking-wider mb-2 px-2">Components</p>
        <ul class="space-y-0.5">
          {components.map((item) => (
            <li>
              <a
                href={`/components/${item.toLowerCase()}`}
                class={`block px-2 py-1.5 text-sm font-mono rounded-sm transition-colors duration-150 ${
                  activeComponent === item.toLowerCase()
                    ? 'text-white bg-surface'
                    : 'text-muted hover:text-white'
                }`}
              >
                {item}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <main class="w-full md:ml-[220px] px-4 md:px-12 py-8 md:py-10 max-w-3xl">
      {isComponent && (
        <a
          href="/components"
          class="md:hidden inline-flex items-center gap-2 font-mono text-sm text-muted hover:text-white transition-colors duration-150 mb-6"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          Components
        </a>
      )}
      <slot />
    </main>
  </div>

</BaseLayout>
