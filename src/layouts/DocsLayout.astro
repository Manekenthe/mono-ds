---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title?: string;
  description?: string;
  activeComponent?: string;
  sections?: { id: string; title: string; sub?: { id: string; title: string }[] }[];
}

const { title, description, activeComponent, sections = [] } = Astro.props;

const overviewItems = [
  { label: 'Introduction', href: '/docs/introduction' },
  { label: 'Get started', href: '/docs/get-started' },
  { label: 'Styling', href: '/docs/styling' },
  { label: 'Skills', href: '/docs/skills' },
  { label: 'Changelog', href: '/docs/changelog' },
  { label: 'Roadmap', href: '/docs/roadmap' },
];

const components = [
  'Accordion','Alert','Alert Dialog','Avatar','Badge','Breadcrumb',
  'Button','Calendar','Card','Checkbox','Checkbox Group','Collapsible',
  'Combobox','Command','Dialog','Input','Select','Slider','Switch',
  'Tabs','Toast','Tooltip',
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(href + '/');
}

function isComponentActive(item: string) {
  const slug = item.toLowerCase().replace(' ', '-');
  return (activeComponent || '') === item.toLowerCase() || (activeComponent || '') === slug;
}
---

<BaseLayout title={title ? `${title} - Mono DS` : 'Mono DS'} description={description}>

  <!-- Top Nav -->
  <header style="position:fixed; top:0; left:0; right:0; z-index:50; display:flex; align-items:center; height:69px; padding:0 18px; background:#121212; border-bottom:1px solid #2A2A2A;">
    <a href="/" class="mono-logo" style="display:flex; align-items:center; flex-shrink:0; margin-right:28px; color:#FFFFFF; text-decoration:none;">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 0C10 5.52285 14.4772 10 20 10C14.4772 10 10 14.4772 10 20C10 14.4772 5.52285 10 0 10C5.52285 10 10 5.52285 10 0Z" fill="white"/>
      </svg>
    </a>
    <nav style="display:flex; align-items:center; gap:4px;">
      <a href="/docs/introduction" class={`nav-btn font-mono font-medium ${currentPath.startsWith('/docs') ? 'nav-btn-active' : ''}`} style="font-size:14px; line-height:20px; padding:6px 12px; border-radius:8px; text-decoration:none;">Docs</a>
      <a href="/components" class={`nav-btn font-mono font-medium ${currentPath.startsWith('/components') ? 'nav-btn-active' : ''}`} style="font-size:14px; line-height:20px; padding:6px 12px; border-radius:8px; text-decoration:none;">Components</a>
    </nav>
    <div style="display:flex; align-items:center; gap:16px; margin-left:auto;">
      <a href="https://github.com/Manekenthe/mono-ds" target="_blank" class="icon-link">
        <svg width="20" height="20" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M16,2a14,14,0,0,0-4.43,27.28c.7.13,1-.3,1-.67s0-1.21,0-2.38c-3.89.84-4.71-1.88-4.71-1.88A3.71,3.71,0,0,0,6.24,22.3c-1.27-.86.1-.85.1-.85A2.94,2.94,0,0,1,8.48,22.9a3,3,0,0,0,4.08,1.16,2.93,2.93,0,0,1,.88-1.87c-3.1-.36-6.37-1.56-6.37-6.92a5.4,5.4,0,0,1,1.44-3.76,5,5,0,0,1,.14-3.7s1.17-.38,3.85,1.43a13.3,13.3,0,0,1,7,0c2.67-1.81,3.84-1.43,3.84-1.43a5,5,0,0,1,.14,3.7,5.4,5.4,0,0,1,1.44,3.76c0,5.38-3.27,6.56-6.39,6.91a3.33,3.33,0,0,1,.95,2.59c0,1.87,0,3.38,0,3.84s.25.81,1,.67A14,14,0,0,0,16,2Z"/></svg>
      </a>
      <a href="https://x.com/builtwithmono" target="_blank" class="icon-link">
        <svg width="20" height="20" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="m18.2342,14.1624 8.7424-10.1624h-2.0717l-7.591,8.8238-6.0629-8.8238h-6.9929l9.1684,13.3432-9.1684,10.6568h2.0718l8.0163-9.3183 6.4029,9.3183h6.9929l-9.5083-13.8376h.0005zm-2.8376,3.2984-.9289-1.3287L7.0763,5.5596h3.1822l5.9649,8.5323.9289,1.3287 7.7536,11.0907h-3.1822l-6.3272-9.05v-.0005z"/></svg>
      </a>
    </div>
  </header>

  <div style="display:flex; padding-top:69px;">

    <!-- Left Sidebar -->
    <aside id="left-sidebar" style="position:fixed; left:0; top:69px; bottom:0; width:270px; background:#121212; overflow-y:auto; padding:18px 40px 32px 24px; z-index:40;">
      <div style="margin-bottom:24px;">
        <p class="font-mono font-medium text-white" style="font-size:12px; line-height:20px; margin-bottom:4px;">Overview</p>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:4px;">
          {overviewItems.map((item) => (
            <li>
              <a href={item.href} class={`sidebar-link font-mono font-medium ${isActive(item.href) ? 'sidebar-link-active' : ''}`} style="font-size:14px; line-height:20px; padding:8px 14px; border-radius:8px; display:block; text-decoration:none;">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-mono font-medium text-white" style="font-size:12px; line-height:20px; margin-bottom:4px;">Components</p>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:4px;">
          {components.map((item) => (
            <li>
              <a
                href={`/components/${item.toLowerCase().replace(' ', '-')}`}
                class={`sidebar-link font-mono font-medium ${isComponentActive(item) ? 'sidebar-link-active' : ''}`}
                style="font-size:14px; line-height:20px; padding:8px 14px; border-radius:8px; display:block; text-decoration:none;"
              >
                {item}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <!-- Main Content -->
    <main id="main-content" style="flex:1; min-width:0; margin-left:270px; margin-right:270px; padding:18px 24px 48px;">
      <div style="border:1px solid #2A2A2A; background:#121212; border-radius:16px; padding:32px;">
        <slot />
      </div>
    </main>

    <!-- Right Sidebar -->
    {sections.length > 0 && (
      <aside id="right-sidebar" style="position:fixed; right:0; top:69px; bottom:0; width:270px; background:#121212; overflow-y:auto; padding:18px 24px 32px 40px; z-index:40;">
        <p class="font-mono font-medium text-white" style="font-size:12px; line-height:20px; height:36px; display:flex; align-items:center;">On this page</p>
        <div style="display:flex;">
          <div style="position:relative; width:1px; background:#2A2A2A; flex-shrink:0; margin-right:14px;">
            <div id="track-indicator" style="position:absolute; top:0; left:-0.5px; width:2px; height:36px; background:#FFFFFF; transition:top 200ms ease;"></div>
          </div>
          <ul id="page-sections" style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:4px; flex:1;">
            {sections.map((section, i) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class={`page-link font-mono font-medium ${i === 0 ? 'page-link-active' : ''}`}
                  data-idx={i}
                  style="font-size:14px; line-height:20px; height:36px; display:flex; align-items:center; text-decoration:none;"
                >
                  {section.title}
                </a>
                {section.sub && section.sub.map((sub) => (
                  <a
                    href={`#${sub.id}`}
                    class="page-link font-mono font-medium"
                    style="font-size:14px; line-height:20px; height:36px; display:flex; align-items:center; text-decoration:none; padding-left:12px;"
                  >
                    {sub.title}
                  </a>
                ))}
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}

  </div>

</BaseLayout>

<style>
  /* Nav */
  .nav-btn { color: #A0A0A0; }
  .nav-btn:hover, .nav-btn-active { background: #1A1A1A !important; color: #FFFFFF !important; }

  /* Icon links */
  .icon-link { color: #A0A0A0; display:flex; align-items:center; transition:color 150ms; }
  .icon-link:hover { color: #FFFFFF; }

  /* Sidebar links */
  .sidebar-link { color: #A0A0A0; }
  .sidebar-link:hover { background: #1A1A1A; color: #FFFFFF; }
  .sidebar-link-active { background: #1A1A1A !important; color: #FFFFFF !important; }

  /* Right sidebar links */
  .page-link { color: #A0A0A0; }
  .page-link:hover { color: #FFFFFF; }
  .page-link-active { color: #FFFFFF !important; }

  /* Responsive */
  @media (max-width: 1024px) {
    #left-sidebar { display: none !important; }
    #right-sidebar { display: none !important; }
    #main-content { margin-left: 0 !important; margin-right: 0 !important; }
  }
</style>

<script>
  var links = document.querySelectorAll('.page-link');
  var indicator = document.getElementById('track-indicator');
  var current = 0;

  function setActive(idx) {
    current = idx;
    links.forEach(function(l, i) {
      l.classList.toggle('page-link-active', i === idx);
    });
    if (indicator) indicator.style.top = (idx * 40) + 'px';
  }

  links.forEach(function(link, i) {
    link.addEventListener('click', function() { setActive(i); });
  });

  var targets = Array.from(document.querySelectorAll('[id]')).filter(function(el) {
    return Array.from(links).some(function(l) { return l.getAttribute('href') === '#' + el.id; });
  });

  if (targets.length > 0 && 'IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          var idx = targets.indexOf(e.target);
          if (idx !== -1) setActive(idx);
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    targets.forEach(function(t) { obs.observe(t); });
  }
</script>
