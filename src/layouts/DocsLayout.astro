---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title?: string;
  description?: string;
  activeComponent?: string;
  sections?: { id: string; title: string; sub?: { id: string; title: string }[] }[];
}

const { title, description, activeComponent, sections = [] } = Astro.props;

const overviewItems = [
  { label: 'Introduction', href: '/docs/introduction' },
  { label: 'Get started', href: '/docs/get-started' },
  { label: 'Styling', href: '/docs/styling' },
  { label: 'Skills', href: '/docs/skills' },
  { label: 'Changelog', href: '/docs/changelog' },
  { label: 'Roadmap', href: '/docs/roadmap' },
];

const components = [
  'Accordion','Alert','Alert Dialog','Avatar','Badge','Breadcrumb',
  'Button','Calendar','Card','Checkbox','Checkbox Group','Collapsible',
  'Combobox','Command','Dialog','Input','Select','Slider','Switch',
  'Tabs','Toast','Tooltip',
];

const isComponent = components.map(c => c.toLowerCase()).includes((activeComponent || '').toLowerCase());
---

<BaseLayout title={title ? `${title} - Mono DS` : 'Mono DS'} description={description}>

  <!-- Top Nav -->
  <header class="fixed top-0 left-0 right-0 z-50 flex items-center border-b border-[#2A2A2A] bg-[#121212]" style="height:69px; padding: 18px;">
    <!-- Logo -->
    <a href="/" class="flex items-center shrink-0" style="margin-right:28px;">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 0C10 5.52285 14.4772 10 20 10C14.4772 10 10 14.4772 10 20C10 14.4772 5.52285 10 0 10C5.52285 10 10 5.52285 10 0Z" fill="white"/>
      </svg>
    </a>
    <!-- Nav links -->
    <nav class="flex items-center" style="gap:16px;">
      <a href="/docs/introduction" class="nav-btn font-mono font-medium text-white" style="font-size:14px; line-height:20px;">Docs</a>
      <a href="/components" class="nav-btn font-mono font-medium text-white" style="font-size:14px; line-height:20px;">Components</a>
    </nav>
    <!-- Icons -->
    <div class="flex items-center ml-auto" style="gap:16px;">
      <a href="https://github.com/Manekenthe/mono-ds" target="_blank" class="text-[#A0A0A0] hover:text-white transition-colors">
        <!-- Carbon: Logo GitHub -->
        <svg width="20" height="20" viewBox="0 0 32 32" fill="currentColor">
          <path d="M16 2a14 14 0 100 28A14 14 0 0016 2zm0 2a12 12 0 0110.18 18.33l-4.24-4.24a5.93 5.93 0 00-1.35-6.21 5.86 5.86 0 00-4.1-1.7 5.93 5.93 0 00-5.66 4.17H8.5a2.5 2.5 0 00-2.5 2.5v3a2.5 2.5 0 002.5 2.5h.72a5.93 5.93 0 003.78 2v1.82a8.25 8.25 0 01-2-.56V26a12 12 0 01-7.15-11h.15a2.5 2.5 0 000-5h-.1A12 12 0 0116 4z"/>
        </svg>
      </a>
      <a href="https://x.com/builtwithmono" target="_blank" class="text-[#A0A0A0] hover:text-white transition-colors">
        <!-- Carbon: Logo X -->
        <svg width="20" height="20" viewBox="0 0 32 32" fill="currentColor">
          <path d="M18.42 14.3L27.5 4h-2.16l-7.9 8.82L11.5 4H4l9.52 13.35L4 28h2.16l8.33-9.29L21.5 28H29zM15.5 17.5l-.97-1.33L7 5.6h3.31l6.2 8.5.97 1.33 8.06 11.07H22.2z"/>
        </svg>
      </a>
    </div>
  </header>

  <div class="flex" style="padding-top:69px;">

    <!-- Left Sidebar -->
    <aside class="fixed left-0 bottom-0 bg-[#121212] overflow-y-auto shrink-0" style="top:69px; width:270px; padding: 18px 40px 32px 24px;">
      <!-- Overview -->
      <div style="margin-bottom:24px;">
        <p class="font-mono font-medium text-white" style="font-size:12px; line-height:20px; margin-bottom:4px;">Overview</p>
        <ul style="display:flex; flex-direction:column; gap:4px;">
          {overviewItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="sidebar-item block font-mono font-medium text-[#A0A0A0] hover:text-white hover:bg-[#1A1A1A] transition-colors"
                style="font-size:14px; line-height:20px; padding: 8px 14px; border-radius:8px; display:block;"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <!-- Components -->
      <div>
        <p class="font-mono font-medium text-white" style="font-size:12px; line-height:20px; margin-bottom:4px;">Components</p>
        <ul style="display:flex; flex-direction:column; gap:4px;">
          {components.map((item) => {
            const slug = item.toLowerCase().replace(' ', '-');
            const isActive = (activeComponent || '') === item.toLowerCase() || (activeComponent || '') === slug;
            return (
              <li>
                <a
                  href={`/components/${slug}`}
                  class={`block font-mono font-medium transition-colors ${isActive ? 'text-white bg-[#1A1A1A]' : 'text-[#A0A0A0] hover:text-white hover:bg-[#1A1A1A]'}`}
                  style="font-size:14px; line-height:20px; padding: 8px 14px; border-radius:8px;"
                >
                  {item}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 min-w-0" style="margin-left:270px; margin-right:270px; padding:18px 24px 48px;">
      <div class="border border-[#2A2A2A] bg-[#121212]" style="border-radius:16px; padding:32px;">

        {isComponent && (
          <a
            href="/components"
            class="md:hidden inline-flex items-center gap-2 font-mono font-medium text-[#A0A0A0] hover:text-white transition-colors"
            style="font-size:14px; margin-bottom:24px; display:none;"
          >
            <svg width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 26 8 16 20 6"></polyline></svg>
            Components
          </a>
        )}

        <slot />
      </div>
    </main>

    <!-- Right Sidebar -->
    {sections.length > 0 && (
      <aside class="fixed right-0 bottom-0 bg-[#121212] overflow-y-auto shrink-0" style="top:69px; width:270px; padding: 18px 24px 32px 40px;">
        <p class="font-mono font-medium text-white" style="font-size:12px; line-height:20px; height:36px; display:flex; align-items:center;">On this page</p>
        <div style="display:flex; gap:0;">
          <!-- Track line -->
          <div class="bg-[#2A2A2A] shrink-0" style="width:1px; margin-right:14px;"></div>
          <!-- Items -->
          <ul style="display:flex; flex-direction:column; gap:4px; flex:1;">
            {sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="on-this-page-item block font-mono font-medium text-[#A0A0A0] hover:text-white transition-colors"
                  style="font-size:14px; line-height:20px; height:36px; display:flex; align-items:center;"
                  data-section={section.id}
                >
                  {section.title}
                </a>
                {section.sub && section.sub.map((sub) => (
                  <a
                    href={`#${sub.id}`}
                    class="on-this-page-item block font-mono font-medium text-[#A0A0A0] hover:text-white transition-colors"
                    style="font-size:14px; line-height:20px; height:36px; display:flex; align-items:center; padding-left:14px;"
                    data-section={sub.id}
                  >
                    {sub.title}
                  </a>
                ))}
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}

  </div>

</BaseLayout>

<style>
  .nav-btn {
    background: transparent;
    padding: 6px 12px;
    border-radius: 8px;
    transition: background 150ms;
    text-decoration: none;
  }
  .nav-btn:hover {
    background: #1A1A1A;
  }
</style>

<script>
  // Right sidebar active state on scroll
  const items = document.querySelectorAll('.on-this-page-item');
  if (items.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          items.forEach((item) => {
            item.style.color = '#A0A0A0';
            item.style.fontWeight = '500';
          });
          const active = document.querySelector(`[data-section="${entry.target.id}"]`);
          if (active) {
            active.style.color = '#FFFFFF';
            active.style.fontWeight = '500';
          }
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('[id]').forEach((el) => observer.observe(el));
  }
</script>
