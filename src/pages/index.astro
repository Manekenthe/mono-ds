---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mono DS - Minimalistic Design System">
  <main class="min-h-screen bg-neutral flex flex-col items-center justify-center px-6 relative overflow-hidden">

    <header class="fixed top-0 left-0 right-0 z-50 flex items-center justify-center gap-6 py-5">
      <a href="https://github.com/Manekenthe/mono-ds" target="_blank" class="text-muted hover:text-white transition-colors duration-150">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
      </a>
      <svg width="20" height="20" viewBox="0 0 32 32" fill="none"><path d="M16 2L30 16L16 30L2 16L16 2Z" fill="white"/></svg>
      <a href="https://x.com/builtwithmono" target="_blank" class="text-muted hover:text-white transition-colors duration-150">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.736l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
    </header>

    <div class="relative z-10 text-center max-w-xl">
      <h1 class="font-mono text-3xl font-medium text-white leading-tight mb-4 tracking-tight">
        Mono components,<br/>installed as source
      </h1>
      <p class="font-mono text-sm text-muted leading-relaxed mb-10 max-w-sm mx-auto">
        Accessible components for React and Tailwind CSS. One command copies the code into your project yours to restyle, extend, and keep.
      </p>
      <div class="flex items-center justify-center gap-3 flex-wrap">
        <a href="/components" class="px-4 py-2 bg-primary text-white text-sm font-mono font-medium rounded-md hover:opacity-90 transition-opacity duration-150">
          Components
        </a>
        <a href="/docs/introduction" class="px-4 py-2 bg-surface text-muted text-sm font-mono font-medium rounded-md border border-border hover:text-white hover:border-muted transition-colors duration-150">
          Documentation
        </a>
      </div>
      <div class="mt-8 inline-flex items-center gap-3 px-4 py-2.5 bg-surface border border-border rounded-md">
        <span class="font-mono text-sm text-muted">npx mono init</span>
        <button id="copy-btn" class="text-muted hover:text-white transition-colors duration-150" aria-label="Copy">
          <svg id="icon-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
          <svg id="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2" class="hidden"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
      </div>
    </div>

  </main>
</BaseLayout>

<script>
  var btn = document.getElementById('copy-btn');
  var iconCopy = document.getElementById('icon-copy');
  var iconCheck = document.getElementById('icon-check');
  btn.addEventListener('click', function() {
    navigator.clipboard.writeText('npx mono init').then(function() {
      iconCopy.classList.add('hidden');
      iconCheck.classList.remove('hidden');
      setTimeout(function() {
        iconCopy.classList.remove('hidden');
        iconCheck.classList.add('hidden');
      }, 2000);
    });
  });
</script>
