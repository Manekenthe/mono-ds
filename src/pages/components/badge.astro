<script>
  var pkgCmds = {
    npx:  { cmd: 'npx mono add badge', html: '<span style="color:#EF4444;">npx</span> <span style="color:#22C55E;">mono</span> <span style="color:#55CFFF;">add</span> <span style="color:#FFFFFF;">badge</span>' },
    bun:  { cmd: 'bunx mono add badge', html: '<span style="color:#EF4444;">bunx</span> <span style="color:#22C55E;">mono</span> <span style="color:#55CFFF;">add</span> <span style="color:#FFFFFF;">badge</span>' },
    pnpm: { cmd: 'pnpm dlx mono add badge', html: '<span style="color:#EF4444;">pnpm</span> <span style="color:#22C55E;">dlx</span> <span style="color:#55CFFF;">mono</span> <span style="color:#FFFFFF;">add badge</span>' },
    yarn: { cmd: 'yarn dlx mono add badge', html: '<span style="color:#EF4444;">yarn</span> <span style="color:#22C55E;">dlx</span> <span style="color:#55CFFF;">mono</span> <span style="color:#FFFFFF;">add badge</span>' },
  };
  var activePkg = 'bun';

  function setPkg(pkg, btn) {
    activePkg = pkg;
    document.getElementById('pkg-cmd').innerHTML = pkgCmds[pkg].html;
    ['npx','bun','pnpm','yarn'].forEach(function(p) {
      var b = document.getElementById('pkg-' + p);
      if (p === pkg) { b.style.background = '#2A2A2A'; b.style.color = '#FFFFFF'; }
      else { b.style.background = 'transparent'; b.style.color = '#A0A0A0'; }
    });
  }

  function copyPkg() {
    navigator.clipboard.writeText(pkgCmds[activePkg].cmd).then(function() {
      document.getElementById('pkg-icon-copy').style.display = 'none';
      document.getElementById('pkg-icon-check').style.display = 'block';
      setTimeout(function() {
        document.getElementById('pkg-icon-copy').style.display = 'block';
        document.getElementById('pkg-icon-check').style.display = 'none';
      }, 2000);
    });
  }

  function show(section, tab, btn) {
    var preview = document.getElementById(section + '-preview');
    var code = document.getElementById(section + '-code');
    var parent = btn.parentElement;
    parent.querySelectorAll('button').forEach(function(b) {
      b.style.background = 'transparent';
      b.style.color = '#A0A0A0';
    });
    btn.style.background = '#2A2A2A';
    btn.style.color = '#FFFFFF';
    if (tab === 'preview') {
      preview.classList.remove('hidden');
      code.classList.add('hidden');
    } else {
      preview.classList.add('hidden');
      code.classList.remove('hidden');
    }
  }

  function copySection(section, btn) {
    var codeEl = document.getElementById(section + '-code');
    if (!codeEl) return;
    navigator.clipboard.writeText(codeEl.innerText.trim()).then(function() {
      var orig = btn.innerHTML;
      btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 32 32" fill="#22C55E"><path d="M13 24L4 15l1.41-1.41L13 21.17l13.59-13.58L28 9z"/></svg>';
      setTimeout(function() { btn.innerHTML = orig; }, 2000);
    });
  }

  window.setPkg = setPkg;
  window.copyPkg = copyPkg;
  window.show = show;
  window.copySection = copySection;
</script>
