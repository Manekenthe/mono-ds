      <div id="pills_x-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; display:flex; align-items:center; justify-content:center;">
        <BadgePills client:load />
      </div>
      <pre id="pills_x-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; color:#FFFFFF;"><code><span style="color:#55CFFF;">&lt;Badge</span> <span style="color:#6F42C1;">pill</span><span style="color:#55CFFF;">&gt;</span>Badge<span style="color:#55CFFF;">&lt;/Badge</span><span style="color:#55CFFF;">&gt;</span>
<span style="color:#55CFFF;">&lt;Badge</span> <span style="color:#6F42C1;">pill</span><span style="color:#55CFFF;">&gt;</span>7<span style="color:#55CFFF;">&lt;/Badge</span><span style="color:#55CFFF;">&gt;</span></code></pre>
