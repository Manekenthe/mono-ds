  <span style="color:#6F42C1;">leadingIcon</span><span style="color:#E36209;">=</span>&#123;<span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">size</span><span style="color:#E36209;">=</span>&#123;14&#125; <span style="color:#55CFFF;">/&gt;</span>&#125;
  <span style="color:#6F42C1;">trailingIcon</span><span style="color:#E36209;">=</span>&#123;<span style="color:#55CFFF;">&lt;IconClose</span> <span style="color:#55CFFF;">/&gt;</span>&#125;
<span style="color:#55CFFF;">&gt;</span>
  Badge
<span style="color:#55CFFF;">&lt;/Badge</span><span style="color:#55CFFF;">&gt;</span></code></pre>
