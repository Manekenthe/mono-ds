      <pre id="success_x-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; color:#FFFFFF;"><code><span style="color:#55CFFF;">&lt;Badge</span> <span style="color:#6F42C1;">variant</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"success"</span><span style="color:#55CFFF;">&gt;</span>Badge<span style="color:#55CFFF;">&lt;/Badge</span><span style="color:#55CFFF;">&gt;</span></code></pre>
    </div>

    <div id="success-light" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Success Light</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Softer version with a tinted background and a colored stroke.</p>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
