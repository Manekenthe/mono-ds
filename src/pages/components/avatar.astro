---
import DocsLayout from '../../layouts/DocsLayout.astro';
import {
  AvatarBasic, AvatarFallback, AvatarSizes, AvatarRadius,
  AvatarBadge, AvatarGroupBasic, AvatarGroupCount
} from '../../components/docs/AvatarPreview';

const sections = [
  { id: 'installation', title: 'Installation' },
  { id: 'usage', title: 'Usage' },
  { id: 'examples', title: 'Examples', sub: [
    { id: 'basic', title: 'Basic Avatar' },
    { id: 'fallback', title: 'Fallback' },
    { id: 'sizes', title: 'Sizes' },
    { id: 'radius', title: 'Radius' },
    { id: 'badge', title: 'Badge' },
    { id: 'group', title: 'Avatar Group' },
    { id: 'count', title: 'Avatar Group with Count' },
  ]},
  { id: 'anatomy', title: 'Anatomy' },
  { id: 'props', title: 'Props' },
];
---

<DocsLayout title="Avatar" description="User profile image or initials." activeComponent="avatar" sections={sections}>

  <h1 class="font-mono font-medium text-white" style="font-size:20px; line-height:32px; margin-bottom:4px;">Avatar</h1>
  <p class="font-mono text-[#A0A0A0]" style="font-size:16px; line-height:24px; font-weight:400; margin-bottom:48px;">An image that represents a user, with a fallback for missing photos.</p>

  <div id="basic" style="margin-bottom:48px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('b0','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('b0','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
        <button onclick="copySection('b0', this)" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex; padding:0;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <div id="b0-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; display:flex; align-items:center; justify-content:center;">
        <AvatarBasic client:load />
      </div>
      <pre id="b0-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; color:#FFFFFF;"><code><span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">alt</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"Profile photo"</span> <span style="color:#55CFFF;">/&gt;</span></code></pre>
  </div>

  <section id="installation" style="margin-bottom:48px;">
    <h2 class="font-mono font-medium text-white" style="font-size:18px; line-height:32px; margin-bottom:16px;">Installation</h2>
    <div style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; overflow:hidden;">
      <div style="display:flex; align-items:center; border-bottom:1px solid #2A2A2A; padding:0 16px; gap:4px;">
        <svg width="16" height="16" viewBox="0 0 32 32" fill="#A0A0A0" style="margin-right:8px; flex-shrink:0;"><path d="M6 22l8-6-8-6v12zM14 22h12v2H14z"/></svg>
        <button onclick="setPkg('npx',this)" id="pkg-npx" class="font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; background:transparent; color:#A0A0A0; border:none; cursor:pointer; border-radius:8px;">npx</button>
        <button onclick="setPkg('bun',this)" id="pkg-bun" class="font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer; border-radius:8px;">bun</button>
        <button onclick="setPkg('pnpm',this)" id="pkg-pnpm" class="font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; background:transparent; color:#A0A0A0; border:none; cursor:pointer; border-radius:8px;">pnpm</button>
        <button onclick="setPkg('yarn',this)" id="pkg-yarn" class="font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; background:transparent; color:#A0A0A0; border:none; cursor:pointer; border-radius:8px;">yarn</button>
        <div style="margin-left:auto;">
          <button onclick="copyPkg()" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex;" aria-label="Copy">
            <svg id="pkg-icon-copy" width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg>
            <svg id="pkg-icon-check" width="16" height="16" viewBox="0 0 32 32" fill="#22C55E" style="display:none;"><path d="M13 24L4 15l1.41-1.41L13 21.17l13.59-13.58L28 9z"/></svg>
          </button>
        </div>
      </div>
      <div style="display:flex; align-items:center; padding:12px 16px;">
        <span class="font-mono" style="color:#A0A0A0; font-size:14px; margin-right:16px; user-select:none;">1</span>
        <code id="pkg-cmd" class="font-mono" style="font-size:14px; line-height:20px;"><span style="color:#EF4444;">pnpm</span> <span style="color:#22C55E;">dlx</span> <span style="color:#55CFFF;">mono</span> <span style="color:#FFFFFF;">add avatar</span></code>
      </div>
    </div>
  </section>

  <section id="usage" style="margin-bottom:48px;">
    <h2 class="font-mono font-medium text-white" style="font-size:18px; line-height:32px; margin-bottom:16px;">Usage</h2>
    <div style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; overflow:hidden; margin-bottom:8px;">
      <div style="display:flex; justify-content:flex-end; border-bottom:1px solid #2A2A2A; padding:8px 16px;">
        <button class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <pre class="font-mono overflow-x-auto" style="padding:20px 24px; font-size:14px; line-height:20px; margin:0; color:#FFFFFF;"><code><span style="color:#A0A0A0; user-select:none; margin-right:16px;">1</span><span style="color:#EF4444;">import</span> &#123; Avatar, AvatarGroup &#125; <span style="color:#EF4444;">from</span> <span style="color:#22C55E;">"@/components/ui/avatar"</span></code></pre>
    </div>
    <div style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; overflow:hidden;">
      <div style="display:flex; justify-content:flex-end; border-bottom:1px solid #2A2A2A; padding:8px 16px;">
        <button class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <pre class="font-mono overflow-x-auto" style="padding:20px 24px; font-size:14px; line-height:20px; margin:0; color:#FFFFFF;"><code><span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">alt</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"Profile photo"</span> <span style="color:#55CFFF;">/&gt;</span></code></pre>
    </div>
  </section>

  <section id="examples" style="margin-bottom:48px;">
    <h2 class="font-mono font-medium text-white" style="font-size:18px; line-height:32px; margin-bottom:32px;">Examples</h2>

    <div id="fallback" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Fallback</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Shown when there is no image. Pass letters, or nothing for the user icon.</p>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('fallback_x','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('fallback_x','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
        <button onclick="copySection('fallback_x', this)" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex; padding:0;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <div id="fallback_x-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; display:flex; align-items:center; justify-content:center;">
        <AvatarFallback client:load />
      </div>
      <pre id="fallback_x-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; color:#FFFFFF;"><code><span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">fallback</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"MF"</span> <span style="color:#55CFFF;">/&gt;</span>
<span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#55CFFF;">/&gt;</span></code></pre>
    </div>

    <div id="sizes" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Sizes</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Use the size prop to scale the avatar.</p>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('sizes_x','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('sizes_x','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
        <button onclick="copySection('sizes_x', this)" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex; padding:0;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <div id="sizes_x-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; display:flex; align-items:center; justify-content:center;">
        <AvatarSizes client:load />
      </div>
      <pre id="sizes_x-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; color:#FFFFFF;"><code><span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">size</span><span style="color:#E36209;">=</span>&#123;24&#125; <span style="color:#55CFFF;">/&gt;</span>
<span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">size</span><span style="color:#E36209;">=</span>&#123;32&#125; <span style="color:#55CFFF;">/&gt;</span>
<span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">size</span><span style="color:#E36209;">=</span>&#123;36&#125; <span style="color:#55CFFF;">/&gt;</span>
<span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">size</span><span style="color:#E36209;">=</span>&#123;40&#125; <span style="color:#55CFFF;">/&gt;</span></code></pre>
    </div>

    <div id="radius" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Radius</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Round the corners with a number, or use full for a circle.</p>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('radius_x','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('radius_x','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
        <button onclick="copySection('radius_x', this)" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex; padding:0;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <div id="radius_x-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; display:flex; align-items:center; justify-content:center;">
        <AvatarRadius client:load />
      </div>
      <pre id="radius_x-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; color:#FFFFFF;"><code><span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">radius</span><span style="color:#E36209;">=</span>&#123;8&#125; <span style="color:#55CFFF;">/&gt;</span>
<span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">radius</span><span style="color:#E36209;">=</span>&#123;12&#125; <span style="color:#55CFFF;">/&gt;</span>
<span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">radius</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"full"</span> <span style="color:#55CFFF;">/&gt;</span></code></pre>
    </div>

    <div id="badge" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Badge</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Show a presence status in the bottom right corner.</p>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('badge_x','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('badge_x','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
        <button onclick="copySection('badge_x', this)" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex; padding:0;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <div id="badge_x-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; display:flex; align-items:center; justify-content:center;">
        <AvatarBadge client:load />
      </div>
      <pre id="badge_x-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; color:#FFFFFF;"><code><span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">status</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"invisible"</span> <span style="color:#55CFFF;">/&gt;</span>
<span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">status</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"online"</span> <span style="color:#55CFFF;">/&gt;</span>
<span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">status</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"idle"</span> <span style="color:#55CFFF;">/&gt;</span>
<span style="color:#55CFFF;">&lt;Avatar</span> <span style="color:#6F42C1;">src</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"/avatars/photo.jpg"</span> <span style="color:#6F42C1;">status</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"dnd"</span> <span style="color:#55CFFF;">/&gt;</span></code></pre>
    </div>

    <div id="group" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Avatar Group</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Stack several avatars with an 8px overlap.</p>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('group_x','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('group_x','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
