      <pre id="info-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; white-space:pre-wrap; word-break:break-word;"><code><span style="color:#6F42C1;">variant</span><span style="color:#FFFFFF;">="info"</span><span style="color:#55CFFF;">{">"}</span>Button<span style="color:#55CFFF;">{"<"}/Button{">"}</span></code></pre>
    </div>

    <div id="success" style="margin-bottom:48px;">
