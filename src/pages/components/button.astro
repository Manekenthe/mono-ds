      <pre id="link-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; white-space:pre-wrap; word-break:break-word;"><code><span style="color:#6F42C1;">variant</span><span style="color:#FFFFFF;">="link"</span><span style="color:#55CFFF;">{">"}</span>Button<span style="color:#55CFFF;">{"<"}/Button{">"}</span></code></pre>
    </div>

    <div id="info" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Info</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Draws attention for informational actions.</p>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('info','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('info','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
        <button onclick="copySection('info', this)" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex; padding:0;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <div id="info-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px;">
        <ButtonInfo client:load />
