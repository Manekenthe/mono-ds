---
import DocsLayout from '../../layouts/DocsLayout.astro';
import {
  ButtonPrimary, ButtonSecondary, ButtonOutline, ButtonGhost, ButtonLink,
  ButtonInfo, ButtonSuccess, ButtonWarning, ButtonDestructive,
  ButtonLeadingIcon, ButtonTrailingIcon, ButtonIconOnly, ButtonDisabled, ButtonSizes
} from '../../components/docs/ButtonPreview';

const sections = [
  { id: 'installation', title: 'Installation' },
  { id: 'usage', title: 'Usage' },
  { id: 'examples', title: 'Examples', sub: [
    { id: 'primary', title: 'Primary' },
    { id: 'secondary', title: 'Secondary' },
    { id: 'outline', title: 'Outline' },
    { id: 'ghost', title: 'Ghost' },
    { id: 'link', title: 'Link' },
    { id: 'info', title: 'Info' },
    { id: 'success', title: 'Success' },
    { id: 'warning', title: 'Warning' },
    { id: 'destructive', title: 'Destructive' },
    { id: 'leading-icon', title: 'With Leading Icon' },
    { id: 'trailing-icon', title: 'With Trailing Icon' },
    { id: 'icon-only', title: 'Icon Only' },
    { id: 'disabled', title: 'Disabled' },
    { id: 'sizes', title: 'Sizes' },
  ]},
  { id: 'anatomy', title: 'Anatomy' },
  { id: 'props', title: 'Props' },
];
---

<DocsLayout title="Button" description="Triggers actions and events." activeComponent="button" sections={sections}>

  <h1 class="font-mono font-medium text-white" style="font-size:20px; line-height:32px; margin-bottom:4px;">Button</h1>
  <p class="font-mono text-[#A0A0A0]" style="font-size:16px; line-height:24px; font-weight:400; margin-bottom:48px;">Triggers actions and events across the interface.</p>

  <!-- Default preview -->
  <div id="primary" style="margin-bottom:48px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('default','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('default','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
        <button onclick="copySection('default', this)" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex; padding:0;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <div id="default-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px;">
        <ButtonPrimary client:load />
      </div>
      <pre id="default-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; white-space:pre-wrap; word-break:break-word;"><code><span style="color:#55CFFF;">{"<"}Button</span> 
<span style="color:#55CFFF;">{"/>"}</span></code></pre>
  </div>

  <!-- Installation -->
  <section id="installation" style="margin-bottom:48px;">
    <h2 class="font-mono font-medium text-white" style="font-size:18px; line-height:32px; margin-bottom:16px;">Installation</h2>
    <div style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; overflow:hidden;">
      <div style="display:flex; align-items:center; border-bottom:1px solid #2A2A2A; padding:0 16px; gap:4px;">
        <svg width="16" height="16" viewBox="0 0 32 32" fill="#A0A0A0" style="margin-right:8px; flex-shrink:0;"><path d="M6 22l8-6-8-6v12zM14 22h12v2H14z"/></svg>
        <button onclick="setPkg('npx',this)" id="pkg-npx" class="font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; background:transparent; color:#A0A0A0; border:none; cursor:pointer; border-radius:8px;">npx</button>
        <button onclick="setPkg('bun',this)" id="pkg-bun" class="font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer; border-radius:8px;">bun</button>
        <button onclick="setPkg('pnpm',this)" id="pkg-pnpm" class="font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; background:transparent; color:#A0A0A0; border:none; cursor:pointer; border-radius:8px;">pnpm</button>
        <button onclick="setPkg('yarn',this)" id="pkg-yarn" class="font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; background:transparent; color:#A0A0A0; border:none; cursor:pointer; border-radius:8px;">yarn</button>
        <div style="margin-left:auto;">
          <button onclick="copyPkg()" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex;" aria-label="Copy">
            <svg id="pkg-icon-copy" width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg>
            <svg id="pkg-icon-check" width="16" height="16" viewBox="0 0 32 32" fill="#22C55E" style="display:none;"><path d="M13 24L4 15l1.41-1.41L13 21.17l13.59-13.58L28 9z"/></svg>
          </button>
        </div>
      </div>
      <div style="display:flex; align-items:center; padding:12px 16px;">
        <span class="font-mono" style="color:#A0A0A0; font-size:14px; margin-right:16px; user-select:none;">1</span>
        <code id="pkg-cmd" class="font-mono" style="font-size:14px; line-height:20px;"><span style="color:#EF4444;">pnpm</span> <span style="color:#22C55E;">dlx</span> <span style="color:#55CFFF;">mono</span> <span style="color:#FFFFFF;">add button</span></code>
      </div>
    </div>
  </section>

  <!-- Usage -->
  <section id="usage" style="margin-bottom:48px;">
    <h2 class="font-mono font-medium text-white" style="font-size:18px; line-height:32px; margin-bottom:16px;">Usage</h2>
    <div style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; overflow:hidden; margin-bottom:8px;">
      <div style="display:flex; justify-content:flex-end; border-bottom:1px solid #2A2A2A; padding:8px 16px;">
        <button class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <pre class="font-mono overflow-x-auto" style="padding:20px 24px; font-size:14px; line-height:20px; margin:0;"><code><span style="color:#A0A0A0; user-select:none; margin-right:16px;">1</span><span style="color:#EF4444;">import</span> <span style="color:#FFFFFF;">{"{"} Button {"}"}</span> <span style="color:#EF4444;">from</span> <span style="color:#22C55E;">"@/components/ui/button"</span></code></pre>
    </div>
    <div style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; overflow:hidden;">
      <div style="display:flex; justify-content:flex-end; border-bottom:1px solid #2A2A2A; padding:8px 16px;">
        <button class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <pre class="font-mono overflow-x-auto" style="padding:20px 24px; font-size:14px; line-height:20px; margin:0;"><code><span style="color:#55CFFF;">{"<"}Button</span> <span style="color:#6F42C1;">variant</span><span style="color:#FFFFFF;">="primary"</span><span style="color:#55CFFF;">{">"}</span>Button<span style="color:#55CFFF;">{"<"}/Button{">"}</span></code></pre>
    </div>
  </section>

  <!-- Examples -->
  <section id="examples" style="margin-bottom:48px;">
    <h2 class="font-mono font-medium text-white" style="font-size:18px; line-height:32px; margin-bottom:32px;">Examples</h2>

    <div id="primary" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Primary</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">The default high-emphasis button.</p>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('primary','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('primary','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
        <button onclick="copySection('primary', this)" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex; padding:0;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <div id="primary-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px;">
        <ButtonPrimary client:load />
      </div>
      <pre id="primary-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; white-space:pre-wrap; word-break:break-word;"><code><span style="color:#6F42C1;">variant</span><span style="color:#FFFFFF;">="primary"</span><span style="color:#55CFFF;">{">"}</span>Button<span style="color:#55CFFF;">{"<"}/Button{">"}</span></code></pre>
    </div>

    <div id="secondary" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Secondary</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Medium-emphasis button for secondary actions.</p>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('secondary','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('secondary','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
        <button onclick="copySection('secondary', this)" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex; padding:0;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <div id="secondary-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px;">
        <ButtonSecondary client:load />
      </div>
      <pre id="secondary-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; white-space:pre-wrap; word-break:break-word;"><code><span style="color:#6F42C1;">variant</span><span style="color:#FFFFFF;">="secondary"</span><span style="color:#55CFFF;">{">"}</span>Button<span style="color:#55CFFF;">{"<"}/Button{">"}</span></code></pre>
    </div>

    <div id="outline" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Outline</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Low-emphasis button with a visible border.</p>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('outline','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('outline','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
        <button onclick="copySection('outline', this)" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex; padding:0;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <div id="outline-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px;">
        <ButtonOutline client:load />
      </div>
      <pre id="outline-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; white-space:pre-wrap; word-break:break-word;"><code><span style="color:#6F42C1;">variant</span><span style="color:#FFFFFF;">="outline"</span><span style="color:#55CFFF;">{">"}</span>Button<span style="color:#55CFFF;">{"<"}/Button{">"}</span></code></pre>
    </div>

    <div id="ghost" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Ghost</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Minimal button, background appears only on hover.</p>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('ghost','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('ghost','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
        <button onclick="copySection('ghost', this)" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex; padding:0;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <div id="ghost-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px;">
        <ButtonGhost client:load />
      </div>
      <pre id="ghost-code" class="hidden code-block font-mono overflow-x-auto" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px; font-size:14px; line-height:20px; margin:0; padding:24px; white-space:pre-wrap; word-break:break-word;"><code><span style="color:#6F42C1;">variant</span><span style="color:#FFFFFF;">="ghost"</span><span style="color:#55CFFF;">{">"}</span>Button<span style="color:#55CFFF;">{"<"}/Button{">"}</span></code></pre>
    </div>

    <div id="link" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Link</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Text-only button, underlines on hover.</p>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <div style="display:flex; gap:4px;">
          <button onclick="show('link','preview',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
          <button onclick="show('link','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px; background:transparent; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
        </div>
        <button onclick="copySection('link', this)" class="copy-btn" style="color:#A0A0A0; background:none; border:none; cursor:pointer; display:flex; padding:0;" aria-label="Copy"><svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg></button>
      </div>
      <div id="link-preview" class="preview-box" style="border:1px solid #2A2A2A; background:#121212; border-radius:8px;">
        <ButtonLink client:load />
