<script>
  var pkgCmds = {
    npx:  { cmd: 'npx mono add accordion', html: '<span style="color:#EF4444;">npx</span> <span style="color:#22C55E;">mono</span> <span style="color:#55CFFF;">add</span> <span style="color:#FFFFFF;">accordion</span>' },
    bun:  { cmd: 'bunx mono add accordion', html: '<span style="color:#EF4444;">bunx</span> <span style="color:#22C55E;">mono</span> <span style="color:#55CFFF;">add</span> <span style="color:#FFFFFF;">accordion</span>' },
    pnpm: { cmd: 'pnpm dlx mono add accordion', html: '<span style="color:#EF4444;">pnpm</span> <span style="color:#22C55E;">dlx</span> <span style="color:#55CFFF;">mono</span> <span style="color:#FFFFFF;">add accordion</span>' },
    yarn: { cmd: 'yarn dlx mono add accordion', html: '<span style="color:#EF4444;">yarn</span> <span style="color:#22C55E;">dlx</span> <span style="color:#55CFFF;">mono</span> <span style="color:#FFFFFF;">add accordion</span>' },
  };
  var activePkg = 'bun';

  function setPkg(pkg, btn) {
    activePkg = pkg;
    document.getElementById('pkg-cmd').innerHTML = pkgCmds[pkg].html;
    ['npx','bun','pnpm','yarn'].forEach(function(p) {
      var b = document.getElementById('pkg-' + p);
      if (p === pkg) { b.style.background = '#2A2A2A'; b.style.color = '#FFFFFF'; }
      else { b.style.background = 'transparent'; b.style.color = '#A0A0A0'; }
    });
  }

  function copyPkg() {
    navigator.clipboard.writeText(pkgCmds[activePkg].cmd).then(function() {
      document.getElementById('pkg-icon-copy').classList.add('hidden');
      document.getElementById('pkg-icon-check').classList.remove('hidden');
      setTimeout(function() {
        document.getElementById('pkg-icon-copy').classList.remove('hidden');
        document.getElementById('pkg-icon-check').classList.add('hidden');
      }, 2000);
    });
  }

  function show(section, tab, btn) {
    var preview = document.getElementById(section + '-preview');
    var code = document.getElementById(section + '-code');
    var parent = btn.parentElement;
    parent.querySelectorAll('button').forEach(function(b) {
      b.style.background = '#121212';
      b.style.color = '#A0A0A0';
    });
    btn.style.background = '#2A2A2A';
    btn.style.color = '#FFFFFF';
    if (tab === 'preview') {
      preview.classList.remove('hidden');
      code.classList.add('hidden');
    } else {
      preview.classList.add('hidden');
      code.classList.remove('hidden');
    }
  }

  window.setPkg = setPkg;
  window.copyPkg = copyPkg;
  window.show = show;
</script>
