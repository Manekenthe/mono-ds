---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { AccordionDefault, AccordionWithIcon, AccordionBorderless, AccordionGrouped, AccordionCards, AccordionMultiple } from '../../components/docs/AccordionPreview';

const sections = [
  { id: 'installation', title: 'Installation' },
  { id: 'usage', title: 'Usage' },
  { id: 'examples', title: 'Examples', sub: [
    { id: 'single', title: 'Single Accordion' },
    { id: 'with-icon', title: 'With Icon' },
    { id: 'borderless', title: 'Borderless' },
    { id: 'grouped', title: 'Grouped' },
    { id: 'cards', title: 'Cards' },
    { id: 'multiple', title: 'Multiple' },
  ]},
  { id: 'anatomy', title: 'Anatomy' },
  { id: 'props', title: 'Props' },
];
---

<DocsLayout title="Accordion" description="Expandable sections." activeComponent="accordion" sections={sections}>

  <!-- Title -->
  <h1 class="font-mono font-medium text-white" style="font-size:20px; line-height:32px; margin-bottom:4px;">Accordion</h1>
  <p class="font-mono text-[#A0A0A0]" style="font-size:16px; line-height:24px; font-weight:400; margin-bottom:48px;">Expandable sections that reveal content one at a time.</p>

  <!-- Default Preview/Code -->
  <div id="single" style="margin-bottom:48px;">
    <div class="flex" style="gap:4px; margin-bottom:0;">
      <button onclick="show('default','preview',this)" class="preview-tab active font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px 8px 0 0; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
      <button onclick="show('default','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px 8px 0 0; background:#121212; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
    </div>
    <div id="default-preview" class="border border-[#2A2A2A] bg-[#1A1A1A]" style="border-radius:0 8px 8px 8px; padding:32px 60px 32px;">
      <AccordionDefault client:load />
    </div>
    <pre id="default-code" class="hidden border border-[#2A2A2A] bg-[#1A1A1A] font-mono overflow-x-auto" style="border-radius:0 8px 8px 8px; padding:32px 60px; font-size:14px; line-height:20px; margin:0;"><code><span style="color:#EF4444;">import</span> <span style="color:#FFFFFF;">{"{"}</span>
  <span style="color:#FFFFFF;">Accordion,</span>
  <span style="color:#FFFFFF;">AccordionItem,</span>
  <span style="color:#FFFFFF;">AccordionPanel,</span>
  <span style="color:#FFFFFF;">AccordionTrigger,</span>
<span style="color:#FFFFFF;">{"}"}</span> <span style="color:#EF4444;">from</span> <span style="color:#22C55E;">"@/components/ui/accordion"</span>

<span style="color:#55CFFF;">{"<"}Accordion</span> <span style="color:#6F42C1;">type</span><span style="color:#E36209;">=</span><span style="color:#FFFFFF;">"single"</span> <span style="color:#6F42C1;">collapsible</span><span style="color:#55CFFF;">{">"}</span>
  <span style="color:#55CFFF;">{"<"}AccordionItem</span> <span style="color:#6F42C1;">value</span><span style="color:#FFFFFF;">="item-1"</span><span style="color:#55CFFF;">{">"}</span>
    <span style="color:#55CFFF;">{"<"}AccordionTrigger</span><span style="color:#55CFFF;">{">"}</span><span style="color:#FFFFFF;">Question</span><span style="color:#55CFFF;">{"<"}/AccordionTrigger{">"}</span>
    <span style="color:#55CFFF;">{"<"}AccordionPanel</span><span style="color:#55CFFF;">{">"}</span><span style="color:#FFFFFF;">Answer</span><span style="color:#55CFFF;">{"<"}/AccordionPanel{">"}</span>
  <span style="color:#55CFFF;">{"<"}/AccordionItem{">"}</span>
<span style="color:#55CFFF;">{"<"}/Accordion{">"}</span></code></pre>
  </div>

  <!-- Installation -->
  <section id="installation" style="margin-bottom:48px;">
    <h2 class="font-mono font-medium text-white" style="font-size:18px; line-height:32px; margin-bottom:16px;">Installation</h2>
    <div class="border border-[#2A2A2A] bg-[#1A1A1A]" style="border-radius:8px; overflow:hidden;">
      <!-- Package tabs row -->
      <div class="flex items-center border-b border-[#2A2A2A]" style="padding:0 16px; gap:4px;">
        <!-- Terminal icon -->
        <svg width="16" height="16" viewBox="0 0 32 32" fill="#A0A0A0" style="margin-right:8px; flex-shrink:0;">
          <path d="M6 22l8-6-8-6v12zM14 22h12v2H14z"/>
        </svg>
        <button onclick="setPkg('npx',this)" id="pkg-npx" class="pkg-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; background:transparent; color:#A0A0A0; border:none; cursor:pointer; border-radius:8px;">npx</button>
        <button onclick="setPkg('bun',this)" id="pkg-bun" class="pkg-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer; border-radius:8px;">bun</button>
        <button onclick="setPkg('pnpm',this)" id="pkg-pnpm" class="pkg-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; background:transparent; color:#A0A0A0; border:none; cursor:pointer; border-radius:8px;">pnpm</button>
        <button onclick="setPkg('yarn',this)" id="pkg-yarn" class="pkg-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; background:transparent; color:#A0A0A0; border:none; cursor:pointer; border-radius:8px;">yarn</button>
        <div class="ml-auto">
          <button onclick="copyPkg()" class="text-[#A0A0A0] hover:text-white transition-colors" aria-label="Copy">
            <!-- Carbon: Copy -->
            <svg id="pkg-icon-copy" width="16" height="16" viewBox="0 0 32 32" fill="currentColor">
              <path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/>
            </svg>
            <svg id="pkg-icon-check" width="16" height="16" viewBox="0 0 32 32" fill="#22C55E" class="hidden">
              <path d="M13 24L4 15l1.41-1.41L13 21.17l13.59-13.58L28 9z"/>
            </svg>
          </button>
        </div>
      </div>
      <!-- Command -->
      <div class="flex items-center" style="padding:12px 16px;">
        <span class="font-mono" style="color:#A0A0A0; font-size:14px; margin-right:16px; user-select:none;">1</span>
        <code id="pkg-cmd" class="font-mono" style="font-size:14px; line-height:20px;"><span style="color:#EF4444;">pnpm</span> <span style="color:#22C55E;">dlx</span> <span style="color:#55CFFF;">mono</span> <span style="color:#FFFFFF;">add accordion</span></code>
      </div>
    </div>
  </section>

  <!-- Usage -->
  <section id="usage" style="margin-bottom:48px;">
    <h2 class="font-mono font-medium text-white" style="font-size:18px; line-height:32px; margin-bottom:16px;">Usage</h2>
    <!-- Import block -->
    <div class="border border-[#2A2A2A] bg-[#1A1A1A]" style="border-radius:8px; overflow:hidden; margin-bottom:8px;">
      <div class="flex items-center justify-end border-b border-[#2A2A2A]" style="padding:8px 16px;">
        <button class="text-[#A0A0A0] hover:text-white transition-colors" aria-label="Copy">
          <svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg>
        </button>
      </div>
      <pre class="font-mono overflow-x-auto" style="padding:20px 24px; font-size:14px; line-height:20px; margin:0;"><code><span style="color:#A0A0A0; user-select:none; margin-right:16px;">1</span><span style="color:#EF4444;">import</span> <span style="color:#FFFFFF;">{"{"}</span>
<span style="color:#A0A0A0; user-select:none; margin-right:16px;">2</span>  <span style="color:#FFFFFF;">Accordion,</span>
<span style="color:#A0A0A0; user-select:none; margin-right:16px;">3</span>  <span style="color:#FFFFFF;">AccordionItem,</span>
<span style="color:#A0A0A0; user-select:none; margin-right:16px;">4</span>  <span style="color:#FFFFFF;">AccordionPanel,</span>
<span style="color:#A0A0A0; user-select:none; margin-right:16px;">5</span>  <span style="color:#FFFFFF;">AccordionTrigger,</span>
<span style="color:#A0A0A0; user-select:none; margin-right:16px;">6</span><span style="color:#FFFFFF;">{"}"}</span> <span style="color:#EF4444;">from</span> <span style="color:#22C55E;">"@/components/ui/accordion"</span></code></pre>
    </div>
    <!-- Usage block -->
    <div class="border border-[#2A2A2A] bg-[#1A1A1A]" style="border-radius:8px; overflow:hidden;">
      <div class="flex items-center justify-end border-b border-[#2A2A2A]" style="padding:8px 16px;">
        <button class="text-[#A0A0A0] hover:text-white transition-colors" aria-label="Copy">
          <svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor"><path d="M28,10V28H10V10H28m0-2H10a2,2,0,0,0-2,2V28a2,2,0,0,0,2,2H28a2,2,0,0,0,2-2V10a2,2,0,0,0-2-2Z"/><path d="M4,18H2V4A2,2,0,0,1,4,2H18V4H4Z"/></svg>
        </button>
      </div>
      <pre class="font-mono overflow-x-auto" style="padding:20px 24px; font-size:14px; line-height:20px; margin:0;"><code><span style="color:#55CFFF;">{"<"}Accordion</span><span style="color:#FFFFFF;">{">"}</span>
  <span style="color:#55CFFF;">{"<"}AccordionItem</span> <span style="color:#6F42C1;">value</span><span style="color:#FFFFFF;">="item-1"</span><span style="color:#55CFFF;">{">"}</span>
    <span style="color:#55CFFF;">{"<"}AccordionTrigger</span><span style="color:#55CFFF;">{">"}</span><span style="color:#FFFFFF;">Is it accessible?</span><span style="color:#55CFFF;">{"<"}/AccordionTrigger{">"}</span>
    <span style="color:#55CFFF;">{"<"}AccordionPanel</span><span style="color:#55CFFF;">{">"}</span>
      <span style="color:#FFFFFF;">Yes. It adheres to the WAI-ARIA design pattern.</span>
    <span style="color:#55CFFF;">{"<"}/AccordionPanel{">"}</span>
  <span style="color:#55CFFF;">{"<"}/AccordionItem{">"}</span>
<span style="color:#55CFFF;">{"<"}/Accordion{">"}</span></code></pre>
    </div>
  </section>

  <!-- Examples -->
  <section id="examples" style="margin-bottom:48px;">
    <h2 class="font-mono font-medium text-white" style="font-size:18px; line-height:32px; margin-bottom:32px;">Examples</h2>

    <!-- With Icon -->
    <div id="with-icon" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">With Icon</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Add Carbon icons to accordion triggers for visual context.</p>
      <div class="flex" style="gap:4px; margin-bottom:0;">
        <button onclick="show('icon','preview',this)" class="preview-tab active font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px 8px 0 0; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
        <button onclick="show('icon','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px 8px 0 0; background:#121212; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
      </div>
      <div id="icon-preview" class="border border-[#2A2A2A] bg-[#1A1A1A]" style="border-radius:0 8px 8px 8px; padding:32px 60px;">
        <AccordionWithIcon client:load />
      </div>
      <pre id="icon-code" class="hidden border border-[#2A2A2A] bg-[#1A1A1A] font-mono overflow-x-auto" style="border-radius:0 8px 8px 8px; padding:32px 60px; font-size:14px; line-height:20px; margin:0;"><code><span style="color:#55CFFF;">{"<"}AccordionItem</span> <span style="color:#6F42C1;">value</span><span style="color:#FFFFFF;">="item-1"</span><span style="color:#55CFFF;">{">"}</span>
  <span style="color:#55CFFF;">{"<"}AccordionTrigger</span> <span style="color:#6F42C1;">icon</span><span style="color:#FFFFFF;">={"{"}{"<"}IconTwoFactor /{">"}{"}"}{">"}</span>
    <span style="color:#FFFFFF;">Two-factor authentication</span>
  <span style="color:#55CFFF;">{"<"}/AccordionTrigger{">"}</span>
  <span style="color:#55CFFF;">{"<"}AccordionPanel{">"}</span><span style="color:#FFFFFF;">Enable 2FA...</span><span style="color:#55CFFF;">{"<"}/AccordionPanel{">"}</span>
<span style="color:#55CFFF;">{"<"}/AccordionItem{">"}</span></code></pre>
    </div>

    <!-- Borderless -->
    <div id="borderless" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Borderless</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">No dividers between items for a minimal look.</p>
      <div class="flex" style="gap:4px;">
        <button onclick="show('borderless','preview',this)" class="preview-tab active font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px 8px 0 0; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
        <button onclick="show('borderless','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px 8px 0 0; background:#121212; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
      </div>
      <div id="borderless-preview" class="border border-[#2A2A2A] bg-[#1A1A1A]" style="border-radius:0 8px 8px 8px; padding:32px 60px;">
        <AccordionBorderless client:load />
      </div>
      <pre id="borderless-code" class="hidden border border-[#2A2A2A] bg-[#1A1A1A] font-mono overflow-x-auto" style="border-radius:0 8px 8px 8px; padding:32px 60px; font-size:14px; line-height:20px; margin:0;"><code><span style="color:#55CFFF;">{"<"}Accordion</span> <span style="color:#6F42C1;">type</span><span style="color:#FFFFFF;">="single"</span> <span style="color:#6F42C1;">collapsible</span> <span style="color:#6F42C1;">variant</span><span style="color:#FFFFFF;">="borderless"</span><span style="color:#55CFFF;">{">"}</span>
  <span style="color:#FFFFFF;">...</span>
<span style="color:#55CFFF;">{"<"}/Accordion{">"}</span></code></pre>
    </div>

    <!-- Grouped -->
    <div id="grouped" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Grouped</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">All items wrapped in a single bordered container.</p>
      <div class="flex" style="gap:4px;">
        <button onclick="show('grouped','preview',this)" class="preview-tab active font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px 8px 0 0; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
        <button onclick="show('grouped','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px 8px 0 0; background:#121212; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
      </div>
      <div id="grouped-preview" class="border border-[#2A2A2A] bg-[#1A1A1A]" style="border-radius:0 8px 8px 8px; padding:32px 60px;">
        <AccordionGrouped client:load />
      </div>
      <pre id="grouped-code" class="hidden border border-[#2A2A2A] bg-[#1A1A1A] font-mono overflow-x-auto" style="border-radius:0 8px 8px 8px; padding:32px 60px; font-size:14px; line-height:20px; margin:0;"><code><span style="color:#55CFFF;">{"<"}Accordion</span> <span style="color:#6F42C1;">type</span><span style="color:#FFFFFF;">="single"</span> <span style="color:#6F42C1;">collapsible</span> <span style="color:#6F42C1;">variant</span><span style="color:#FFFFFF;">="grouped"</span><span style="color:#55CFFF;">{">"}</span>
  <span style="color:#FFFFFF;">...</span>
<span style="color:#55CFFF;">{"<"}/Accordion{">"}</span></code></pre>
    </div>

    <!-- Cards -->
    <div id="cards" style="margin-bottom:48px;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Cards</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Each item as an individual card with its own border.</p>
      <div class="flex" style="gap:4px;">
        <button onclick="show('cards','preview',this)" class="preview-tab active font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px 8px 0 0; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
        <button onclick="show('cards','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px 8px 0 0; background:#121212; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
      </div>
      <div id="cards-preview" class="border border-[#2A2A2A] bg-[#1A1A1A]" style="border-radius:0 8px 8px 8px; padding:32px 60px;">
        <AccordionCards client:load />
      </div>
      <pre id="cards-code" class="hidden border border-[#2A2A2A] bg-[#1A1A1A] font-mono overflow-x-auto" style="border-radius:0 8px 8px 8px; padding:32px 60px; font-size:14px; line-height:20px; margin:0;"><code><span style="color:#55CFFF;">{"<"}Accordion</span> <span style="color:#6F42C1;">type</span><span style="color:#FFFFFF;">="single"</span> <span style="color:#6F42C1;">collapsible</span> <span style="color:#6F42C1;">variant</span><span style="color:#FFFFFF;">="cards"</span><span style="color:#55CFFF;">{">"}</span>
  <span style="color:#FFFFFF;">...</span>
<span style="color:#55CFFF;">{"<"}/Accordion{">"}</span></code></pre>
    </div>

    <!-- Multiple -->
    <div id="multiple" style="margin-bottom:0;">
      <h3 class="font-mono font-medium text-white" style="font-size:14px; line-height:20px; margin-bottom:4px;">Multiple</h3>
      <p class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; margin-bottom:16px;">Multiple items can be open simultaneously.</p>
      <div class="flex" style="gap:4px;">
        <button onclick="show('multiple','preview',this)" class="preview-tab active font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px 8px 0 0; background:#2A2A2A; color:#FFFFFF; border:none; cursor:pointer;">Preview</button>
        <button onclick="show('multiple','code',this)" class="preview-tab font-mono font-medium" style="font-size:14px; line-height:20px; padding:8px 12px; border-radius:8px 8px 0 0; background:#121212; color:#A0A0A0; border:none; cursor:pointer;">Code</button>
      </div>
      <div id="multiple-preview" class="border border-[#2A2A2A] bg-[#1A1A1A]" style="border-radius:0 8px 8px 8px; padding:32px 60px;">
        <AccordionMultiple client:load />
      </div>
      <pre id="multiple-code" class="hidden border border-[#2A2A2A] bg-[#1A1A1A] font-mono overflow-x-auto" style="border-radius:0 8px 8px 8px; padding:32px 60px; font-size:14px; line-height:20px; margin:0;"><code><span style="color:#55CFFF;">{"<"}Accordion</span> <span style="color:#6F42C1;">type</span><span style="color:#FFFFFF;">="multiple"</span> <span style="color:#6F42C1;">variant</span><span style="color:#FFFFFF;">="default"</span><span style="color:#55CFFF;">{">"}</span>
  <span style="color:#FFFFFF;">...</span>
<span style="color:#55CFFF;">{"<"}/Accordion{">"}</span></code></pre>
    </div>
  </section>

  <!-- Anatomy -->
  <section id="anatomy" style="margin-bottom:48px;">
    <h2 class="font-mono font-medium text-white" style="font-size:18px; line-height:32px; margin-bottom:16px;">Anatomy</h2>
    <ul class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; display:flex; flex-direction:column; gap:4px; padding-left:0; list-style:none;">
      <li><span class="text-white">Accordion</span> - Root container that manages open/close state</li>
      <li><span class="text-white">AccordionItem</span> - Individual collapsible section</li>
      <li><span class="text-white">AccordionTrigger</span> - Clickable header that toggles visibility</li>
      <li><span class="text-white">AccordionPanel</span> - Expandable content area</li>
    </ul>
  </section>

  <!-- Props -->
  <section id="props">
    <h2 class="font-mono font-medium text-white" style="font-size:18px; line-height:32px; margin-bottom:24px;">Props</h2>

    <h3 class="font-mono font-medium text-[#A0A0A0]" style="font-size:12px; line-height:20px; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:12px;">Accordion</h3>
    <div class="border border-[#2A2A2A] overflow-hidden" style="border-radius:8px; margin-bottom:24px;">
      <table class="w-full font-mono" style="font-size:12px; line-height:20px; border-collapse:collapse;">
        <thead>
          <tr class="border-b border-[#2A2A2A]">
            <th class="text-left text-[#A0A0A0] font-medium" style="padding:12px 16px;">Prop</th>
            <th class="text-left text-[#A0A0A0] font-medium" style="padding:12px 16px;">Type</th>
            <th class="text-left text-[#A0A0A0] font-medium" style="padding:12px 16px;">Default</th>
          </tr>
        </thead>
